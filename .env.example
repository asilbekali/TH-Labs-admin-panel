# ---------------------------------------------------------------------------
# API location
# ---------------------------------------------------------------------------
#
# The panel only ever holds the API's base URL. No LEMONSQUEEZY_API_KEY, no
# secret of any kind belongs in this file or in panel
# code — anyone who loads the bundle can read it. Those live on the API.

# Origin the dev server proxies /api to. The account API runs on port 3001
# locally; leave this pointed at production to work against live data.
#   local backend:  http://localhost:3001
#   production:     https://th-labs.uz
VITE_API_ORIGIN=https://th-labs.uz

# Where the browser sends API calls.
#
# Leave this UNSET in development so requests go through the dev proxy at /api
# (rewritten to /v1). That keeps the browser same-origin, so CORS never enters
# the picture and the refresh cookie is not treated as third-party.
#
# Set it in production only if the panel is NOT served from the same origin as
# the API. Two things must then be true on the server or auth silently breaks:
#
#   1. This panel's origin is listed in the API's CORS_ORIGINS (comma-separated).
#   2. The panel is served over HTTPS. In production the refresh cookie is
#      SameSite=None; Secure, and a browser drops such a cookie on an http://
#      page without any error — every reload would log the admin out.
#
# VITE_API_BASE_URL=https://th-labs.uz/v1
