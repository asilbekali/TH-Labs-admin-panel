# Origin the dev server proxies /api to. Defaults to https://th-labs.uz.
# Point this at a local backend when running one (e.g. http://localhost:3000).
VITE_API_ORIGIN=https://th-labs.uz

# Where the browser sends API calls. Leave unset in development so requests go
# through the dev proxy at /api — the API only allows CORS from th-labs.uz, so
# calling it directly from localhost will be blocked by the browser.
#
# In production, set this only if the panel is NOT served from the same origin
# as the API, and make sure that origin is added to the backend's CORS allowlist.
# VITE_API_BASE_URL=https://th-labs.uz/v1

# Built-in default admin.
#
# If the backend rejects the credentials (or is unreachable), signing in with
# these drops into the panel as a local SUPERADMIN. It is a client-side session
# with no access token, so live data calls still fail — it exists so the panel
# can be opened before a real admin account exists.
#
# Anyone who can load the bundle can read these values. Set
# VITE_ENABLE_DEFAULT_ADMIN=false on any deployment pointed at a real backend.
# VITE_ENABLE_DEFAULT_ADMIN=false
# VITE_DEFAULT_ADMIN_EMAIL=super@gmail.com
# VITE_DEFAULT_ADMIN_PASSWORD=iamadmin
